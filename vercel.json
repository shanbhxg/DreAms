{
    "version": 2,
    "functions": {
      "api/api.py": {
        "runtime": "python3.9"  
      }
    },
    "builds": [
      {
        "src": "api/api.py",
        "use": "@vercel/python"
      },
      {
        "src": "package.json",
        "use": "@vercel/static-build",
        "config": {
          "distDir": "dist"
        }
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "/api/api.py"
      },
      {
        "src": "/(.*)",
        "dest": "/dist/$1"
      }
    ]
  }
  